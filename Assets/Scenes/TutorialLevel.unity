      propertyPath: 'stages.Array.data[3].startDialogue.Array.data[4]'
      value: "\u786E\u8BA4\u540E\uFF0C\u4ECE\u53F3\u4FA7\u51FA\u53E3\u79BB\u5F00\u3002\u5DE6\u4FA7\u95E8\u53EA\u662F\u672C\u5C42\u5165\u53E3\u3002"

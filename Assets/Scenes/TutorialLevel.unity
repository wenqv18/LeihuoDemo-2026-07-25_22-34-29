      value: "\u518D\u7528\u6444\u50CF\u673A\u786E\u8BA4\u6B63\u5E38\u4E16\u754C\u91CC\u7684\u5F02\u5E38\u6E90\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[3].startDialogue.Array.data[3]'
      value: "\u82E5\u5760\u5165\u4FB5\u8680\u4E16\u754C\uFF0C\u5BFB\u627E\u5E72\u51C0\u3001\u7A33\u5B9A\u3001\u4E0D\u88AB\u6C61\u67D3\u7684\u951A\u70B9\u3002"

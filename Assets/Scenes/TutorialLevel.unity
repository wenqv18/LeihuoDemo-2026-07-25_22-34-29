    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[1].startDialogue.Array.data[0]'
      value: "\u7814\u7A76\u6240\u7ED9\u4F60\u7684\u6838\u5FC3\u88C5\u5907\uFF0C\u662F\u8FD9\u53F0\u5F02\u5E38\u4FA6\u6D4B\u6444\u50CF\u673A\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[1].startDialogue.Array.data[1]'
      value: "\u6309\u6570\u5B57\u952E 1 \u6253\u5F00\u6216\u6536\u8D77\u6444\u50CF\u673A\u3002\u53D6\u666F\u6846\u4F1A\u8DDF\u968F\u9F20\u6807\u79FB\u52A8\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[1].startDialogue.Array.data[2]'
      value: "\u5B83\u80FD\u77ED\u6682\u770B\u7A7F\u6B63\u5E38\u7A7A\u95F4\uFF0C\u770B\u5230\u88AB\u4FB5\u8680\u7269\u4F53\u7559\u4E0B\u7684\u53E6\u4E00\u5C42\u75D5\u8FF9\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[1].startDialogue.Array.data[3]'
      value: "\u8FD9\u6B21\u76EE\u6807\u662F\u684C\u5B50\u3002\u5BF9\u51C6\u5B83\uFF0C\u957F\u6309\u9F20\u6807\u5DE6\u952E\u5B8C\u6210\u62CD\u6444\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[1].startDialogue.Array.data[4]'
      value: "\u6B63\u5F0F\u5173\u91CC\uFF0C\u76EE\u6807\u4E0D\u4F1A\u603B\u662F\u88AB\u70B9\u540D\uFF0C\u4F60\u8981\u5148\u9760\u6587\u672C\u63A8\u7406\uFF0C\u518D\u7528\u6444\u50CF\u673A\u786E\u8BA4\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: stages.Array.data[2].completeDialogue.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[0]'
      value: "\u5982\u679C\u5224\u65AD\u9519\u8BEF\uFF0C\u7CBE\u795E\u7A33\u5B9A\u5EA6\u4F1A\u4E0B\u964D\u3002\u8FDE\u7EED\u5931\u8BEF\u4F1A\u628A\u4F60\u62D6\u5165\u4FB5\u8680\u4E16\u754C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[1]'
      value: "\u90A3\u91CC\u4E0D\u662F\u53E6\u4E00\u95F4\u529E\u516C\u5BA4\uFF0C\u800C\u662F\u5B9E\u9A8C\u6CC4\u9732\u540E\u7684\u5E95\u5C42\u7A7A\u95F4\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[2]'
      value: "\u4FB5\u8680\u4E16\u754C\u91CC\u4E0D\u80FD\u4F7F\u7528\u6444\u50CF\u673A\uFF0C\u505C\u7559\u65F6\u95F4\u4E5F\u5F88\u77ED\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[3]'
      value: "\u4F60\u8981\u5BFB\u627E\u4E0D\u53D7\u4FB5\u8680\u5F71\u54CD\u7684\u951A\u70B9\u3002\u5B83\u5F80\u5F80\u5E72\u51C0\u3001\u7A33\u5B9A\uFF0C\u751A\u81F3\u663E\u5F97\u8FC7\u4E8E\u6B63\u5E38\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 990927257, guid: a9f42ac1964c5de40a2d683c4cecaee6, type: 3}
      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[4]'
      value: "\u73B0\u5728\u6545\u610F\u5728\u684C\u5B50\u5916\u62CD\u9519\u51E0\u6B21\uFF0C\u8FDB\u5165\u4FB5\u8680\u4E16\u754C\u540E\u9760\u8FD1\u540A\u706F\uFF0C\u957F\u6309\u9F20\u6807\u5DE6\u952E\u8FD4\u56DE\u3002"
      objectReference: {fileID: 0}

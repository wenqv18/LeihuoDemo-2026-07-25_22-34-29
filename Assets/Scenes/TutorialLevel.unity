      propertyPath: 'stages.Array.data[2].startDialogue.Array.data[5]'
      value: "\u73B0\u5728\uFF0C\u5728\u684C\u5B50\u5916\u968F\u4FBF\u62CD\u9519\u4E09\u6B21\uFF0C\u7136\u540E\u9760\u8FD1\u540A\u706F\uFF0C\u957F\u6309\u9F20\u6807\u5DE6\u952E\u8FD4\u56DE\u3002"
